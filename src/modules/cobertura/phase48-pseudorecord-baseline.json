{
  "identity": "personas_prevent_identificador_interno_update()",
  "definition": "CREATE OR REPLACE FUNCTION public.personas_prevent_identificador_interno_update()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF NEW.identificador_interno IS DISTINCT FROM OLD.identificador_interno THEN\n    RAISE EXCEPTION 'identificador_interno is immutable';\n  END IF;\n\n  RETURN NEW;\nEND;\n$function$\n",
  "definition_sha256": "ac5951e93e991f155ffb498509228a7e62d5a35e00ab001c09edad3468a01745",
  "triggers": [
    {
      "name": "trg_personas_prevent_identificador_interno_update",
      "schema": "public",
      "relation": "personas",
      "enabled": "O",
      "type": 19,
      "internal": false,
      "definition": "CREATE TRIGGER trg_personas_prevent_identificador_interno_update BEFORE UPDATE OF identificador_interno ON public.personas FOR EACH ROW EXECUTE FUNCTION personas_prevent_identificador_interno_update()"
    }
